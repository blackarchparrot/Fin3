# OpenRouter API Key (Optional for live LLM; if omitted, FinPilot operates in full Deterministic Demo Mode)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# OpenRouter Free Model (Default: meta-llama/llama-3.3-70b-instruct:free)
# Available free models:
# - meta-llama/llama-3.3-70b-instruct:free
# - stepfun/step-3.5-flash:free
# - qwen/qwen-2.5-72b-instruct:free
# - cognitivecomputations/dolphin3.0-r1-mistral-24b:free
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# APP_URL: The URL where this applet is hosted.
# In production, injected by Cloud Run, Cloudflare Pages, or deployment environment.
APP_URL="http://localhost:3000"
